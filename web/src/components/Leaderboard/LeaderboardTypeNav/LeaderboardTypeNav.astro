---
import "./LeaderboardTypeNav.scss";

interface Props {
  currentType?: "dungeon" | "player" | "character" | "total-runs";
  currentTab?:
    | "home"
    | "dungeon"
    | "player"
    | "character"
    | "total-runs"
    | "stats"
    | "gear"
    | "status";
  currentRegion?: string;
  currentRealm?: string;
  currentSeason?: number;
  currentDungeon?: string;
  currentClass?: string;
  // Active spec slug, used when the Gear tab needs to preserve the current
  // spec selection across other-tab clicks (and also seeds the default Gear
  // landing when navigating from elsewhere).
  currentSpec?: string;
}

const {
  currentType = "dungeon",
  currentTab = currentType,
  currentRegion = "global",
  currentRealm = "",
  currentSeason = 1,
  currentDungeon = "temple-of-the-jade-serpent",
  currentClass = "all",
  currentSpec = "monk-mistweaver",
} = Astro.props;

// Dungeon/Player leaderboards always require a real season slug. Stats also
// supports an "all-time" cross-season view (currentSeason === 0). When we're on
// the all-time stats page, fall back to the latest known season for the other
// tabs so the URLs still resolve.
const FALLBACK_SEASON = 2;
const navSeason = currentSeason > 0 ? currentSeason : FALLBACK_SEASON;
const navSeasonSlug = `season${navSeason}`;
const statsSeasonSlug =
  currentSeason > 0 ? `season${currentSeason}` : "all-time";
const basePath = Astro.url.pathname.startsWith("/test-challenge-mode")
  ? "test-challenge-mode"
  : "challenge-mode";

let dungeonUrl: string;
if (currentRegion === "global") {
  dungeonUrl = `/${basePath}/${navSeasonSlug}/global/${currentDungeon}`;
} else if (currentRealm && currentRealm !== "all") {
  dungeonUrl = `/${basePath}/${navSeasonSlug}/${currentRegion}/${currentRealm}/${currentDungeon}`;
} else {
  dungeonUrl = `/${basePath}/${navSeasonSlug}/${currentRegion}/all/${currentDungeon}`;
}

// Player tab points at the account-grouped leaderboard. Realm scope filters to
// accounts whose main character lives on that realm.
let playerUrl: string;
if (currentRegion === "global") {
  playerUrl = `/${basePath}/${navSeasonSlug}/players/global`;
} else if (currentRealm && currentRealm !== "all") {
  playerUrl = `/${basePath}/${navSeasonSlug}/players/${currentRegion}/${currentRealm}`;
} else {
  playerUrl = `/${basePath}/${navSeasonSlug}/players/${currentRegion}`;
}

// Character tab is the per-character leaderboard previously known as "Players".
let characterUrl: string;
if (currentRegion === "global") {
  characterUrl = `/${basePath}/${navSeasonSlug}/characters/global${currentClass !== "all" ? `/${currentClass}` : ""}`;
} else if (currentRealm && currentRealm !== "all") {
  characterUrl = `/${basePath}/${navSeasonSlug}/characters/${currentRegion}/${currentRealm}${currentClass !== "all" ? `/${currentClass}` : ""}`;
} else {
  characterUrl = `/${basePath}/${navSeasonSlug}/characters/${currentRegion}${currentClass !== "all" ? `/${currentClass}` : ""}`;
}

// no season segment: cross-season
let totalRunsUrl: string;
if (currentRegion === "global") {
  totalRunsUrl = `/${basePath}/players/total-runs/global${currentClass !== "all" ? `/${currentClass}` : ""}`;
} else if (currentRealm && currentRealm !== "all") {
  totalRunsUrl = `/${basePath}/players/total-runs/${currentRegion}/${currentRealm}${currentClass !== "all" ? `/${currentClass}` : ""}`;
} else {
  totalRunsUrl = `/${basePath}/players/total-runs/${currentRegion}${currentClass !== "all" ? `/${currentClass}` : ""}`;
}

// Stats is region-only (no realm); URL pattern is /(season{N}|all-time)/stats/{region}.
const statsUrl = `/${basePath}/${statsSeasonSlug}/stats/${currentRegion}`;

// Gear is global-only (no region); URL pattern is /season{N}/gear/{spec-slug}.
// Falls back to navSeason since gear isn't available cross-season ("all-time").
const gearUrl = `/${basePath}/${navSeasonSlug}/gear/${currentSpec}`;
---

<nav class="leaderboard-type-nav">
  <a href="/" class:list={["nav-tab", { active: currentTab === "home" }]}>
    Home
  </a>
  <a
    href={dungeonUrl}
    class:list={["nav-tab", { active: currentTab === "dungeon" }]}
  >
    Dungeons
  </a>
  <a
    href={playerUrl}
    class:list={[
      "nav-tab",
      {
        active:
          currentTab === "player" ||
          currentTab === "character" ||
          currentTab === "total-runs",
      },
    ]}
  >
    Players
  </a>
  <a
    href={statsUrl}
    class:list={["nav-tab", { active: currentTab === "stats" }]}
  >
    Stats
  </a>
  <a href={gearUrl} class:list={["nav-tab", { active: currentTab === "gear" }]}>
    Gear
  </a>
  <a
    href="/challenge-mode/status"
    class:list={["nav-tab", { active: currentTab === "status" }]}
  >
    Status
  </a>
  <a
    class="nav-tab discord-link"
    href="https://discord.gg/etxRSDNxFr"
    rel="noopener noreferrer"
  >
    Challenge Mode Discord</a
  >
</nav>
